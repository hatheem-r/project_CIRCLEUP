# SerpAPI key for the google_maps engine. Set it in Render's dashboard, do not
# upload a .env file: the project-root one also holds a Moodle feed token.
SERPAPI_KEY=

# Comma separated origins allowed to call this service, e.g.
# https://circleup.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
